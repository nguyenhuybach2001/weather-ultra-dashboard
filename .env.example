NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_KEY
# Push is optional. Without these the dashboard still works and the UI shows setup needed.
APP_ORIGIN=https://YOUR_DASHBOARD_DOMAIN
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:YOUR_CONTACT_EMAIL
SUPABASE_SERVICE_ROLE_KEY=
# Random shared pairing code (16+ characters), provided privately to station users.
PUSH_PAIRING_CODE=
# Separate server-only random secret (32+ characters), used by FastAPI to send alerts.
PUSH_SEND_SECRET=

# Speaker control is public; no pairing code required.
WEATHER_DEVICE_ID=weather-ultra-01
